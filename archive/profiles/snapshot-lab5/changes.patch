+void bt_session_init(bt_session *s, const bt_transport *io,
+                     bt_line_fn emit, void *context, uint32_t now)
+{
+    memset(s, 0, sizeof(*s)); s->io = *io; s->fd = -1;
+    s->retry_at = s->last_receive = now;
+    bt_text_init(&s->receiver, emit, context);
