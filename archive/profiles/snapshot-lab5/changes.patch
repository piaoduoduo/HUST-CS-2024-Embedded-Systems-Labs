+"""Build only lab5 overlay; never modify or replace the earlier labs3-5 package."""
+from pathlib import Path
+import ast, hashlib, json, tarfile
+ROOT=Path(__file__).resolve().parents[1]; WORK=ROOT.parent
+def sha(path): return hashlib.sha256(path.read_bytes()).hexdigest()
+files=[]
+for folder in ('common','lab5_bt','out'):
+    for source in sorted((ROOT/folder).glob('*')):
+        if not source.is_file(): continue
+        relative=source.relative_to(ROOT); previous=[]
+        for base in (WORK/'course-source/lab-st-2026',WORK/'labs3-5-prepared',
+                     WORK/'lab4-prepared',WORK/'lab6-gomoku-prepared',WORK/'lab3-prepared',WORK/'lab2-prepared'):
+            old=base/relative
+            if old.is_file(): previous.append(sha(old))
+        # Save course originals so the installer test can simulate an untouched tree.
+        original=WORK/'course-source/lab-st-2026'/relative
