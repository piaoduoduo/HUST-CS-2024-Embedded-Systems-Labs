+#include "../common/common.h"
+#include "text_stream.h"
+#include "serial_queue.h"
+#include <termios.h>
+#include <signal.h>
+
+#define BACKGROUND FB_COLOR(255,255,255)
+#define INK FB_COLOR(20,25,35)
+#define SEND_X (SCREEN_WIDTH-100)
+#define RX_TOP 90
+static int serial_fd = -1, headless, pen_y = RX_TOP;
+static volatile sig_atomic_t stopped;
+static bt_text_stream receiver;
+static bt_tx_queue outgoing;
+static myTime last_receive;
+
+static void on_signal(int sig) { (void)sig; stopped = 1; }
+
+static int write_serial(const char *data, size_t length, void *context)
+{
+    (void)context;
+    ssize_t n = write(serial_fd, data, length);
+    if(n > 0) return (int)n;
+    if(n < 0 && errno == EINTR) return BT_IO_RETRY;
+    if(n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return BT_IO_WAIT;
+    return BT_IO_ERROR;
+}
+
+static void transmit_pending(void)
+{
+    if(bt_tx_flush(&outgoing, write_serial, NULL) < 0) {
+        perror("Bluetooth write"); exit(EXIT_FAILURE);
+    }
+}
+
+static void send_hello(void)
+{
+    const char message[] = "hello\n";
+    if(bt_tx_enqueue(&outgoing, message, sizeof(message)-1) < 0) {
+        fprintf(stderr, "Send queue full; wait and tap again.\n");
+        return;
+    }
+    printf("Bluetooth TX queued: hello\n");
+    transmit_pending();
+}
+
+static void receive_line(const char *line, void *context)
+{
+    (void)context;
+    printf("Bluetooth RX: %s\n", line);
+    if(headless) return;
+    int x = 10;
+    size_t i = 0, length = strlen(line);
+    while(i < length) {
+        fb_font_info info;
+        fb_image *glyph = fb_read_font_image(line+i, 24, &info);
+        if(!glyph || info.bytes <= 0) { fb_free_image(glyph); break; }
+        if(x + info.advance_x > SCREEN_WIDTH-10) { x = 10; pen_y += 30; }
+        if(pen_y > SCREEN_HEIGHT-10) {
+            fb_draw_rect(0, 64, SCREEN_WIDTH, SCREEN_HEIGHT-64, BACKGROUND);
+            pen_y = RX_TOP;
+        }
+        fb_draw_image(x+info.left, pen_y-info.top, glyph, INK);
+        x += info.advance_x; i += (size_t)info.bytes;
+        fb_free_image(glyph);
+    }
+    pen_y += 30;
+    fb_update();
+}
+
+static void serial_event_cb(int fd)
+{
+    uint8_t data[256];
+    for(;;) {
+        ssize_t n = read(fd, data, sizeof(data));
+        if(n > 0) {
+            last_receive = task_get_time();
+            bt_text_feed(&receiver, data, (size_t)n);
+            continue;
+        }
+        if(n < 0 && errno == EINTR) continue;
+        if(n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+        bt_text_flush(&receiver, 1);
+        fprintf(stderr, "Bluetooth connection ended; reconnect RFCOMM and restart lab5_bt.\n");
+        exit(n == 0 ? EXIT_SUCCESS : EXIT_FAILURE);
+    }
+}
+
+static void touch_event_cb(int fd)
+{
+    int type, x, y, finger;
+    while((type = touch_read(fd, &x, &y, &finger)) != TOUCH_NO_EVENT) {
+        if(type == TOUCH_ERROR) {
+            task_delete_file(fd); close(fd);
+            fprintf(stderr, "Touch device unavailable; Bluetooth reception remains active.\n");
+            return;
+        }
+        if(type == TOUCH_PRESS && x >= SEND_X && y < 64) send_hello();
+    }
+}
+
+static void timer_cb(int period)
+{
+    static unsigned counter;
+    (void)period;
+    if(stopped) { bt_text_flush(&receiver, 1); exit(EXIT_SUCCESS); }
+    transmit_pending();
+    if(MYTIME_DIFF(task_get_time(), last_receive) >= 500)
+        bt_text_flush(&receiver, 0); /* Apps without newline still display their text. */
+    if(!headless) {
+        char text[40];
+        snprintf(text, sizeof(text), "ticks %u", counter++);
+        fb_draw_rect(SEND_X-180, 0, 180, 64, BACKGROUND);
+        fb_draw_text(SEND_X-170, 40, text, 24, INK);
+        fb_update();
+    }
+}
+
+static void close_serial(void)
+{
+    if(serial_fd >= 0) close(serial_fd);
+}
+
+int main(int argc, char **argv)
+{
+    char *serial_dev = "/dev/rfcomm0", *touch_dev = NULL;
+    int initial_hello = 0;
+    for(int i = 1; i < argc; ++i) {
+        if(strcmp(argv[i], "--headless") == 0) headless = 1;
+        else if(strcmp(argv[i], "--send-hello") == 0) initial_hello = 1;
+        else if(strcmp(argv[i], "--serial") == 0 && i+1 < argc) serial_dev = argv[++i];
+        else if(strcmp(argv[i], "--touch") == 0 && i+1 < argc) touch_dev = argv[++i];
+        else {
+            fprintf(stderr, "Usage: %s [--serial /dev/rfcomm0] [--touch /dev/input/eventN] [--headless] [--send-hello]\n", argv[0]);
+            return EXIT_FAILURE;
+        }
+    }
+    setvbuf(stdout, NULL, _IOLBF, 0);
+    serial_fd = open(serial_dev, O_RDWR | O_NOCTTY | O_NONBLOCK);
+    if(serial_fd < 0) { perror(serial_dev); return EXIT_FAILURE; }
+    atexit(close_serial);
+    struct termios tty;
+    if(tcgetattr(serial_fd, &tty) < 0) { perror("tcgetattr"); return EXIT_FAILURE; }
+    cfmakeraw(&tty);
+    tty.c_cflag |= CLOCAL | CREAD;
+    /* O_NONBLOCK returns EAGAIN while idle; zero-byte reads indicate hangup. */
+    tty.c_cc[VMIN] = 1; tty.c_cc[VTIME] = 0;
+    if(tcsetattr(serial_fd, TCSANOW, &tty) < 0) { perror("tcsetattr"); return EXIT_FAILURE; }
+    signal(SIGINT, on_signal); signal(SIGTERM, on_signal);
+    bt_text_init(&receiver, receive_line, NULL);
+    last_receive = task_get_time();
+    if(!headless) {
+        fb_init("/dev/fb0"); font_init("./font.ttc");
+        fb_draw_rect(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, BACKGROUND);
+        fb_draw_text(10, 40, "蓝牙串口收发", 28, INK);
+        fb_draw_border(SEND_X, 0, 100, 64, INK);
+        fb_draw_text(SEND_X+15, 40, "send", 24, INK);
+        fb_update();
+        int touch_fd = touch_init(touch_dev);
+        if(touch_fd < 0) return EXIT_FAILURE;
+        task_add_file(touch_fd, touch_event_cb);
+    }
+    printf("Bluetooth serial ready: %s\n", serial_dev);
+    task_add_file(serial_fd, serial_event_cb);
+    task_add_timer(100, timer_cb);
+    if(initial_hello) send_hello();
+    task_loop();
+    return 0;
+}
