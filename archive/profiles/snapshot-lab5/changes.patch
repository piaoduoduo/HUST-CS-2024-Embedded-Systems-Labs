+    int32_t ys[FINGER_NUM_MAX+1]={ABS_MT_POSITION_Y};
+    if(ioctl(fd,EVIOCGMTSLOTS(sizeof(ids)),ids)<0 ||
+       ioctl(fd,EVIOCGMTSLOTS(sizeof(xs)),xs)<0 ||
+       ioctl(fd,EVIOCGMTSLOTS(sizeof(ys)),ys)<0) return 0;
+    int count=slot->maximum+1;
+    if(count>FINGER_NUM_MAX) count=FINGER_NUM_MAX;
+    touch_state_init(&state);
+    touch_state_slot(&state,slot->value);
