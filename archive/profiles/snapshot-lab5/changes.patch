+"""Safe source overlay installer. Default: inspect only. No network or service changes."""
+from pathlib import Path
+import argparse, datetime, hashlib, json, os, shutil, sys
+
+ROOT=Path(__file__).resolve().parent
+def digest(path):return hashlib.sha256(path.read_bytes()).hexdigest()
+def inside(base,relative):
+    path=(base/relative).resolve()
+    try:path.relative_to(base)
+    except ValueError:raise ValueError(f"Path leaves project: {relative}")
+    if path==base:raise ValueError(f"Path leaves project: {relative}")
+    return path
+
+def install(project,apply=False):
+    project=Path(project).resolve(strict=True)
+    manifest=json.loads((ROOT/"manifest.json").read_text(encoding="utf-8"))
+    sentinel=project/"common/common.h"
+    if not sentinel.is_file() or digest(sentinel)!=manifest["courseHeaderSHA256"]:
+        raise ValueError("This is not the matching 2026 course project (common/common.h differs).")
+    changes=[]
+    for item in manifest["files"]:
+        source=inside(ROOT,item["path"]);target=inside(project,item["path"])
+        if digest(source)!=item["sha256"]:raise ValueError(f"Prepared source changed: {item['path']}")
+        if target.with_name(target.name+".codex-new").exists():
+            raise ValueError(f"Temporary path already exists beside: {target}")
+        if target.exists():
+            if not target.is_file():raise ValueError(f"Target is not a regular file: {target}")
+            current=digest(target)
+            if current==item["sha256"]:continue
+            if current not in item["allowedPreviousSHA256"]:
+                raise ValueError(f"Existing edits would be overwritten: {item['path']}. Save/review those edits first.")
+        changes.append((item,source,target))
+    print(f"Project: {project}\nFiles needing installation: {len(changes)}")
+    if not apply:
+        print("Inspection only. Add --apply to back up and install these files.")
+        return None
+    if not changes:
+        print("Already installed; no files changed.");return None
+    backup_parent=inside(project,".codex-backups")
+    backup_parent.mkdir(exist_ok=True)
+    stamp=datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
+    backup=backup_parent/("lab5-"+stamp);backup.mkdir()
+    records=[]
+    for item,source,target in changes:
+        existed=target.exists()
+        if existed:
+            saved=backup/item["path"];saved.parent.mkdir(parents=True,exist_ok=True)
+            shutil.copy2(target,saved)
+        records.append({"path":item["path"],"existed":existed,
+                        "oldSHA256":digest(target) if existed else None,"installedSHA256":item["sha256"]})
+    (backup/"backup.json").write_text(json.dumps({"project":str(project),"files":records},ensure_ascii=False,indent=2),encoding="utf-8")
+    for item,source,target in changes:
+        target.parent.mkdir(parents=True,exist_ok=True)
+        temporary=target.with_name(target.name+".codex-new")
+        if temporary.exists():raise ValueError(f"Temporary path already exists: {temporary}")
+        try:
+            shutil.copy2(source,temporary);os.replace(temporary,target)
+        finally:
+            if temporary.exists():temporary.unlink()
+    print(f"Installed. Backup of previous files: {backup}\nNo binaries were run and no system services were changed.")
+    return backup
+
+if __name__=="__main__":
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--project",required=True,help="Existing extracted lab-st-2026 directory")
+    parser.add_argument("--apply",action="store_true")
+    args=parser.parse_args()
+    try:install(args.project,args.apply)
+    except (OSError,ValueError) as error:print(f"STOP: {error}",file=sys.stderr);sys.exit(1)
