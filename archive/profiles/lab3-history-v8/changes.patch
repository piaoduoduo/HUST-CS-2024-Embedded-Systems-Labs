+"""Recover governor settings from this tool's journal after forced termination."""
+from pathlib import Path
+import argparse,json,os,re
+p=argparse.ArgumentParser(description=__doc__);p.add_argument('journal');a=p.parse_args()
+if os.name!='posix':p.error('Linux board only')
+file=Path(a.journal).resolve(strict=True);data=json.loads(file.read_text())
+for name,old in data.get('governors',{}).items():
+    if not re.fullmatch(r'/sys/devices/system/cpu/cpufreq/policy\d+/scaling_governor',name):raise ValueError('Unexpected governor path')
+    path=Path(name)
+    if old not in (path.parent/'scaling_available_governors').read_text().split():raise ValueError('Unsupported recorded governor')
+for name,old in data.get('governors',{}).items():Path(name).write_text(old)
+data['manualGovernorRestore']=True;file.write_text(json.dumps(data,ensure_ascii=False,indent=2))
+print('Recorded governor settings restored. Affinity was confined to the terminated helper process.')
