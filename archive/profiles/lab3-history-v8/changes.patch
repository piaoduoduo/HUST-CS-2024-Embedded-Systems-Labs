+    for(int w=0;w<=257;w++)for(int type=1;type<=3;type++)for(int mode=0;mode<4;mode++)for(int offset=0;offset<4;offset++){
+        unsigned char *src=storage+offset;
+        uint32_t ink=next();
+        for(int i=0;i<260;i++)dst[i]=expected[i]=next();
+        for(int i=0;i<w;i++){
