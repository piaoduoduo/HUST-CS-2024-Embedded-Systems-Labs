+
+static void _copy_area(int *dst, int *src, struct area *pa)
+{
+	int x, y, w, h;
+	x = pa->x1; w = pa->x2-x;
+	y = pa->y1; h = pa->y2-y;
+	char *psrc = (char *)src + y*(SCREEN_WIDTH*4) + x*4;
+	char *pdst = (char *)dst + y*LCD_FB_LINELEN + x*4;
