+            fb_draw_pixel((int)minor, (int)major, color);
+        } else {
+            fb_draw_pixel((int)major, (int)minor, color);
+        }
+        remainder += minor_distance;
+        if(remainder >= length) {
+            remainder -= length;
+            minor += direction;
+        }
+    }
+    return;
