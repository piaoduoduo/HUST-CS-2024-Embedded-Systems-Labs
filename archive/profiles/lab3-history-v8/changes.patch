+                   str(ROOT/'test'/('sprint-v6-main.c' if variant in ('v6-sprint','v7-sprint','v8-packed','v8-sprint') else 'sprint-main.c' if variant=='v5-sprint' else 'batch-main.c' if 'batch' in variant else 'main.c')), str(ROOT/'flush_probe.c'),
+                   '-L'+str(external/'lib'), '-ljpeg','-lfreetype','-lpng','-lasound','-lz','-lm',
+                   '-o',str(out/'test')]
+        results['commands'][variant] = command
