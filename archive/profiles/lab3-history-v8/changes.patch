+
+    #ifndef FB_PARALLEL_MIN_PIXELS
+    #define FB_PARALLEL_MIN_PIXELS 65536
+    #endif
+    #ifdef _OPENMP
+    if((size_t)w*h>=FB_PARALLEL_MIN_PIXELS) {
