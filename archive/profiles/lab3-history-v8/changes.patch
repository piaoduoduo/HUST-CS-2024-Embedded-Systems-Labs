+def scenario(build_only=False,fail=False):
+    original_read=Path.read_text;original_write=Path.write_text;original_glob=Path.glob
+    base='/sys/devices/system/cpu/cpufreq'
+    files={base+'/policy0/scaling_governor':'ondemand',base+'/policy4/scaling_governor':'ondemand'}
+    for policy in ('policy0','policy4'):files[base+'/'+policy+'/scaling_available_governors']='ondemand performance'
+    for cpu in range(6):files['/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq'%cpu]=str(1800000 if cpu>=4 else 1416000)
+    affinity=[set(range(6))];writes=[]
+    def read(p,*a,**k):
+        return files[p.as_posix()] if p.as_posix().startswith('/sys/') else original_read(p,*a,**k)
+    def write(p,value,*a,**k):
+        name=p.as_posix()
+        if name.startswith('/sys/'):
+            if fail and name.endswith('policy4/scaling_governor') and value=='performance':raise PermissionError('simulated failure')
+            files[name]=value;writes.append((name,value));return len(value)
+        return original_write(p,value,*a,**k)
