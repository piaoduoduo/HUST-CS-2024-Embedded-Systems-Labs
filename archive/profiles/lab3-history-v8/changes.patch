+    if(pixels>512U*1024U)return NULL;
+    uint64_t required=pixels*(bytes+sizeof(struct fb_prepared_span))+
+        ((uint64_t)source->pixel_h+1)*sizeof(unsigned)+sizeof(fb_prepared_image);
