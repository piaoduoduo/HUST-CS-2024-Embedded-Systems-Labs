+        if variant.endswith('parallel') or variant in ('v5-sprint','v6-sprint','v7-sprint','v8-packed','v8-sprint'):flags+=['-fopenmp','-DFB_PARALLEL_MIN_PIXELS='+str(args.threshold)]
