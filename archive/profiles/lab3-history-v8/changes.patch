+"""Explicit temporary board settings, journaled and restored on normal exit/signals."""
+from pathlib import Path
+import atexit,json,os,signal
+class RuntimeControls:
+    def __init__(self,args,record,environment):
+        self.path=record/'runtime-controls.json';self.original={};self.restored=False
+        self.affinity=set(os.sched_getaffinity(0));self.journal={'originalAffinity':sorted(self.affinity),'governors':{},'restoreErrors':[]}
+        names=[k for k in environment if k.startswith(('OMP_','GOMP_'))]
+        self.journal['inheritedThreadEnvironment']={k:environment[k] for k in names}
+        for k in names:environment.pop(k,None)
+        environment.update(OMP_NUM_THREADS=str(args.threads),OMP_THREAD_LIMIT=str(args.threads),
+            OMP_DYNAMIC='FALSE',OMP_MAX_ACTIVE_LEVELS='1',OMP_WAIT_POLICY='ACTIVE' if args.active_wait else 'PASSIVE')
+        self.journal['effectiveThreadEnvironment']={k:v for k,v in environment.items() if k.startswith(('OMP_','GOMP_'))}
+        atexit.register(self.restore)
+        signal.signal(signal.SIGTERM,self.terminate)
+        try:
+            if not args.build_only:
+                if args.bind=='fast':
+                    speeds={}
+                    for cpu in self.affinity:
+                        p=Path('/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq'%cpu)
+                        try:speeds[cpu]=int(p.read_text())
+                        except (OSError,ValueError):pass
+                    if len(speeds)!=len(self.affinity):raise RuntimeError('Cannot identify all allowed CPU speeds; use --bind none')
+                    fastest=max(speeds.values());cpus={c for c,v in speeds.items() if v==fastest}
+                    os.sched_setaffinity(0,cpus);self.journal['cpuMaxFrequencies']=speeds
+                if args.governor=='performance':
+                    policies=sorted(Path('/sys/devices/system/cpu/cpufreq').glob('policy*'))
+                    if not policies:raise RuntimeError('No CPU frequency policies; use --governor keep')
+                    for policy in policies:
+                        path=policy/'scaling_governor';old=path.read_text().strip()
+                        if 'performance' not in (policy/'scaling_available_governors').read_text().split():
+                            raise RuntimeError('performance governor unavailable: '+str(policy))
+                        self.original[str(path)]=old;self.journal['governors'][str(path)]=old;self.save()
+                        path.write_text('performance')
+                        if path.read_text().strip()!='performance':raise RuntimeError('Governor request was not applied: '+str(path))
+            self.journal['effectiveAffinity']=sorted(os.sched_getaffinity(0))
+            self.journal['oversubscribed']=args.threads>len(self.journal['effectiveAffinity'])
+            self.journal['buildOnlyNoSystemChanges']=args.build_only;self.save()
+        except BaseException:
+            self.restore();raise
+    def save(self):self.path.write_text(json.dumps(self.journal,ensure_ascii=False,indent=2))
+    def terminate(self,*_):raise SystemExit(143)
+    def restore(self):
+        if self.restored:return
+        for name,value in self.original.items():
+            try:Path(name).write_text(value)
+            except OSError as e:self.journal['restoreErrors'].append(str(e))
+        try:os.sched_setaffinity(0,self.affinity)
+        except OSError as e:self.journal['restoreErrors'].append(str(e))
+        self.restored=True;self.journal['restored']=not self.journal['restoreErrors'];self.save()
+        if self.journal['restoreErrors']:print('Restore incomplete; inspect '+str(self.path),flush=True)
