+	if(pa->y1 < 0) pa->y1 = 0;
+	if(pa->y2 > SCREEN_HEIGHT) pa->y2 = SCREEN_HEIGHT;
+
+	if((pa->x2 > pa->x1) && (pa->y2 > pa->y1))
+		return 1; //no empty
+
+	//set empty
+	AREA_SET_EMPTY(pa);
+	return 0;
+}
+
+void fb_update(void)
+{
+	if(_check_area(&update_area) == 0) return; //is empty
+	_copy_area(LCD_FB_BUF, DRAW_BUF, &update_area);
+	AREA_SET_EMPTY(&update_area); //set empty
+	return;
+}
