+    for(int64_t major = first; major <= last; ++major) {
+        if(inside) {
+            int x = (int)(steep ? minor : major);
+            int y = (int)(steep ? major : minor);
+            DRAW_BUF[y * SCREEN_WIDTH + x] = color;
