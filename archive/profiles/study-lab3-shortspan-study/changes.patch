+struct fb_prepared_image {fb_image *image;unsigned *rows;struct fb_prepared_span *spans;unsigned count;};
+void fb_free_prepared(fb_prepared_image *p)
+{
+    if(!p)return;
+    fb_free_image(p->image);free(p->rows);free(p->spans);free(p);
