+
+static FT_Library library=NULL;
+static FT_Face face;
+
+/* Cache rendered glyphs for any text/size. Returned images remain caller-owned.
+ * Round-robin eviction bounds retained bitmap data to 64 * 64 KiB.
+ * Failed cache allocations simply fall back to normal FreeType rendering.
+ */
+#define GLYPH_CACHE_COUNT 64
+#define GLYPH_CACHE_MAX_BYTES (64U * 1024U)
+static struct glyph_cache_entry {
+	FT_Face face;
+	FT_ULong codepoint;
+	int pixel_size;
+	fb_font_info info;
+	fb_image *image;
+} glyph_cache[GLYPH_CACHE_COUNT];
+static unsigned glyph_cache_next;
+
+static fb_image *copy_glyph_image(const fb_image *source)
+{
+	fb_image *copy = fb_new_image(source->color_type, source->pixel_w,
+		source->pixel_h, source->line_byte);
+	if(copy && source->pixel_h && source->line_byte)
+		memcpy(copy->content, source->content,
+			(size_t)source->pixel_h * source->line_byte);
+	return copy;
+}
