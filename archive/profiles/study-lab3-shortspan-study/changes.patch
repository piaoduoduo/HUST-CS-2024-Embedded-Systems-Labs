+static void fb_line_inside(int x1,int y1,int x2,int y2,int color)
+{
+    int dx=x2-x1,dy=y2-y1,steep=abs(dy)>abs(dx);
+    int major1=steep?y1:x1,major2=steep?y2:x2;
+    int minor1=steep?x1:y1,minor2=steep?x2:y2;
+    if(major1>major2) {
