+#include <fcntl.h>
+#include <stdio.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <linux/fb.h>
+
+#include "common.h"
+#include <limits.h>
+
+/*w, h maybe == 0*/
+fb_image * fb_new_image(int color_type, int w, int h, int line_byte)
+{
+	fb_image *image;
+
+	if((w<0)||(h<0) || w > INT_MAX/4) return NULL;
+	switch(color_type)
+	{
+	case FB_COLOR_RGB_8880:
+	case FB_COLOR_RGBA_8888:
+		if(line_byte < w*4) line_byte = w*4;
+		break;
+	case FB_COLOR_ALPHA_8:
+		if(line_byte < w) line_byte = w;
+		break;
+	default:
+		return NULL;
+	}
+
+	if(line_byte < 0 || (h > 0 && (size_t)line_byte > (SIZE_MAX-sizeof(fb_image))/(size_t)h)) return NULL;
+	image = (fb_image *)malloc(sizeof(fb_image) + (size_t)line_byte*h);
+	if(image == NULL) return NULL;
+
+	image->color_type = color_type;
+	image->line_byte = line_byte;
+	image->pixel_w = w;
+	image->pixel_h = h;
+	image->content = (char *)(image+1);
+	return image;
+}
+
+fb_image *fb_get_sub_image(fb_image *img, int x, int y, int w, int h)
+{
+	fb_image *ret;
+	if(img == NULL) return NULL;
+	if((x<0)||(y<0)||
+		(w<0)||(h<0)||
+		((int64_t)x+w > img->pixel_w)||
+		((int64_t)y+h > img->pixel_h))
+		return NULL;
+
+	ret = (fb_image *)malloc(sizeof(fb_image));
+	if(ret != NULL) {
+		ret->color_type = img->color_type;
+		ret->line_byte = img->line_byte;
+		ret->pixel_w = w;
+		ret->pixel_h = h;
+		if(img->color_type != FB_COLOR_ALPHA_8) x*=4;
+		ret->content = img->content + (size_t)y*img->line_byte + x;
+	}
+	return ret;
+}
+
+void fb_free_image(fb_image *image)
+{
+	if(image) free(image);
+}
