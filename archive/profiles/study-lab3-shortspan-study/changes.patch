+	if(h > 1) {
+		fb_draw_rect(x, y+h-1, w, 1, color);
+		fb_draw_rect(x, y+1, 1, h-2, color);
+		if(w > 1) fb_draw_rect(x+w-1, y+1, 1, h-2, color);
+	}
