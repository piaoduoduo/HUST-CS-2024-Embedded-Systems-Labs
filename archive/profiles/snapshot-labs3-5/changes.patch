+{
+    if(!alpha) return background;
+    uint32_t result = UINT32_C(0xff000000);
+    for(unsigned channel = 0; channel < 3; ++channel) {
+        unsigned shift = channel*8;
+        double mixed = ((foreground>>shift)&255)*(alpha/255.0) +
