@@ -0,0 +1,60 @@
+"""Read-only checks on the Orange Pi. Does not stop the desktop or change Bluetooth."""
+from pathlib import Path
+import argparse, array, fcntl, json, os, shutil, subprocess, sys
+
+def touchscreen_info(path):
+    descriptor=os.open(path,os.O_RDONLY|os.O_NONBLOCK)
+    try:
+        axes={}
+        for name,code in (("slot",0x2f),("x",0x35),("y",0x36)):
+            values=array.array("i",[0]*6)
+            request=(2<<30)|(24<<16)|(ord("E")<<8)|(0x40+code)
+            fcntl.ioctl(descriptor,request,values,True)
+            axes[name]={"minimum":values[1],"maximum":values[2]}
+        return {"path":str(path),"axes":axes}
+    finally:os.close(descriptor)
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--project",required=True)
+    parser.add_argument("--lab",choices=("lab2","lab3","lab4","lab5_bt","test"),required=True)
+    parser.add_argument("--touch");parser.add_argument("--serial",default="/dev/rfcomm0")
+    parser.add_argument("--headless",action="store_true")
+    args=parser.parse_args();project=Path(args.project).resolve(strict=True)
+    failures=[];info={"project":str(project),"lab":args.lab,"checksAreReadOnly":True}
+    binary=project/"out"/args.lab
+    if not binary.is_file() or not os.access(binary,os.X_OK):failures.append(f"Build executable first: {binary}")
+    if not args.headless:
+        try:
+            descriptor=os.open("/dev/fb0",os.O_RDONLY)
+            try:
+                values=array.array("I",[0]*40);fcntl.ioctl(descriptor,0x4600,values,True)
+            finally:os.close(descriptor)
+            info["framebuffer"]={"width":values[0],"height":values[1],"bitsPerPixel":values[6],
+                "red":[values[8],values[9]],"green":[values[11],values[12]],"blue":[values[14],values[15]]}
+            if (values[0],values[1],values[6],values[8],values[9],values[11],values[12],values[14],values[15])!=(1024,600,32,16,8,8,8,0,8):
+                failures.append("Framebuffer format differs from course constants; adjust mode/code before running.")
+        except OSError as error:failures.append(f"Framebuffer unavailable: {error}")
+        if not os.access("/dev/fb0",os.R_OK|os.W_OK):failures.append("Framebuffer is not readable/writable.")
+        for name in ("font.ttc", "test.jpg", "test.png"):
+            if args.lab in ("lab3","test") or name=="font.ttc":
+                if not (project/"out"/name).is_file():failures.append(f"Missing asset: out/{name}")
+        if args.lab in ("lab4","lab5_bt"):
+            devices=[]
+            for path in ([Path(args.touch)] if args.touch else sorted(Path("/dev/input").glob("event*"))):
+                try:devices.append(touchscreen_info(path))
+                except OSError:continue
+            info["protocolBTouchscreens"]=devices
+            if not devices:failures.append("No protocol-B touchscreen detected; check its USB touch cable.")
+            if len(devices)>1 and not args.touch:failures.append("Multiple touchscreens; choose --touch /dev/input/eventN explicitly.")
+        if shutil.which("systemctl"):
+            check=subprocess.run(["systemctl","is-active","display-manager"],capture_output=True,text=True)
+            info["displayManager"]=check.stdout.strip()
+            if check.returncode==0:
+                failures.append("Board desktop is active. Follow PPT 37-38 to stop the board desktop before framebuffer experiments.")
