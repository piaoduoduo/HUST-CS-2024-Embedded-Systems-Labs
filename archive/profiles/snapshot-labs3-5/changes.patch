+	switch(color_type)
+	{
+	case FB_COLOR_RGB_8880:
+	case FB_COLOR_RGBA_8888:
+		if(line_byte < w*4) line_byte = w*4;
+		break;
+	case FB_COLOR_ALPHA_8:
+		if(line_byte < w) line_byte = w;
+		break;
+	default:
+		return NULL;
