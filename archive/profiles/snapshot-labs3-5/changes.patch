@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -euo pipefail
+if [ "$#" -ne 1 ]; then echo "Usage: bash build-on-board.sh /absolute/path/lab-st-2026" >&2; exit 2; fi
+project_dir=$(realpath -- "$1")
+test -f "$project_dir/common/touch_protocol.c"
+test -f "$project_dir/lab5_bt/serial_queue.c"
+command -v gcc >/dev/null
+if [ ! -e "$project_dir/common/external/lib/libjpeg.so" ]; then
+    echo 'Missing course-library symlinks. Extract the original .tgz on Linux before installing this overlay.' >&2
+    exit 1
+fi
+build_log=$(mktemp -d "$project_dir/build-record-XXXXXX")
+exec > >(tee "$build_log/build.log") 2>&1
+date -Is
+uname -a
+gcc --version
+for lab in lab2 lab3 lab4 lab5_bt test; do
+    echo "Building $lab"
+    make -B -C "$project_dir/$lab" CC=gcc
+    file "$project_dir/out/$lab"
+done
+echo "Build completed. Log: $build_log/build.log"
+echo 'Programs have not been run. Use preflight and the physical acceptance checklist.'
