+static int LCD_FB_FD;
+static int *LCD_FB_BUF = NULL;
+static int DRAW_BUF[SCREEN_WIDTH*SCREEN_HEIGHT];
+
+static struct area {
+	int x1, x2, y1, y2;
+} update_area = {0,0,0,0};
+
+#define AREA_SET_EMPTY(pa) do {\
+	(pa)->x1 = SCREEN_WIDTH;\
+	(pa)->x2 = 0;\
+	(pa)->y1 = SCREEN_HEIGHT;\
+	(pa)->y2 = 0;\
+} while(0)
