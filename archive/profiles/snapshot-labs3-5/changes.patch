+#include "serial_queue.h"
+#include <string.h>
+int bt_tx_enqueue(bt_tx_queue *q,const char *data,size_t length)
+{
+    if(length > sizeof(q->bytes)-(q->length-q->offset)) return -1;
+    if(q->offset) memmove(q->bytes,q->bytes+q->offset,q->length-q->offset);
+    q->length-=q->offset;q->offset=0;
+    memcpy(q->bytes+q->length,data,length);q->length+=length;
+    return 0;
+}
+int bt_tx_flush(bt_tx_queue *q,bt_writer_fn writer,void *context)
+{
+    while(q->offset < q->length) {
+        size_t remaining=q->length-q->offset;
+        int n=writer(q->bytes+q->offset,remaining,context);
+        if(n==BT_IO_RETRY) continue;
+        if(n==BT_IO_WAIT) return 0;
+        if(n<=0 || (size_t)n>remaining) return -1;
+        q->offset+=(size_t)n;
+    }
+    q->length=q->offset=0;
+    return 1;
+}
