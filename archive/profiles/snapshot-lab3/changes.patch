+#!/usr/bin/env bash
+set -euo pipefail
+if [ "$#" -ne 1 ]; then
+    echo 'Usage: bash build-on-board.sh /absolute/path/to/lab-st-2026' >&2
+    exit 2
+fi
+project_dir=$(realpath -- "$1")
+test -f "$project_dir/common/common.h"
+test -e "$project_dir/common/external/lib/libjpeg.so"
+record_dir=$(mktemp -d "$project_dir/build-lab3-XXXXXX")
+exec > >(tee "$record_dir/build.log") 2>&1
+date -Is
+gcc --version
+for lab in lab3 test; do
+    make -B -C "$project_dir/$lab" CC=gcc CFLAGS='-Wall -O3'
+    file "$project_dir/out/$lab"
+done
+echo "Build log: $record_dir/build.log"
