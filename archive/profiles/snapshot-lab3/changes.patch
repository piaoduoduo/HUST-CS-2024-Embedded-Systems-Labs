+#include "common.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+void baseline_font_init(char *path);
+fb_image *baseline_fb_read_font_image(const char *, int, fb_font_info *);
+void baseline_fb_free_image(fb_image *);
+
+static unsigned cases;
+static void compare(const char *text, int size)
+{
+    fb_font_info expected_info = {0}, actual_info = {0};
+    fb_image *expected = baseline_fb_read_font_image(text, size, &expected_info);
+    assert(expected);
+    for (int repeat = 0; repeat < 3; ++repeat) {
+        fb_image *actual = fb_read_font_image(text, size, &actual_info);
+        assert(actual && actual->color_type == expected->color_type);
+        assert(actual->pixel_w == expected->pixel_w && actual->pixel_h == expected->pixel_h);
+        assert(actual->line_byte == expected->line_byte);
+        assert(actual_info.bytes == expected_info.bytes);
+        assert(actual_info.advance_x == expected_info.advance_x);
+        assert(actual_info.left == expected_info.left && actual_info.top == expected_info.top);
+        size_t bytes = (size_t)actual->line_byte * actual->pixel_h;
+        assert(memcmp(actual->content, expected->content, bytes) == 0);
+        /* Clients own returned storage: mutation must not change a cached glyph. */
+        memset(actual->content, 0x5a, bytes);
+        fb_free_image(actual);
+        ++cases;
+    }
+    baseline_fb_free_image(expected);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    font_init(argv[1]);
+    baseline_font_init(argv[1]);
+    const char *samples[] = {" ", "A", "g", "嵌", "入", "式", "系", "统", "床", "前", "明", "月", "光", "。", "é", "😀"};
+    const int sizes[] = {20, 30, 40, 64};
+    for (unsigned pass = 0; pass < 2; ++pass) {
+        for (unsigned s = 0; s < sizeof(sizes)/sizeof(sizes[0]); ++s) {
+            for (unsigned i = 0; i < sizeof(samples)/sizeof(samples[0]); ++i)
+                compare(samples[i], sizes[s]);
+        }
+        /* More distinct keys than the cache capacity exercises eviction. */
+        for (int c = 32; c < 127; ++c) {
+            char text[2] = {(char)c, 0};
+            compare(text, 31 + (c % 5));
+        }
+    }
+    compare("嵌", 512); /* Oversized bitmap bypasses the bounded cache. */
+    compare("嵌", 30);
+    printf("PASS: %u real FreeType glyph comparisons, including hits, eviction, sizes, UTF-8, empty glyphs and caller ownership\n", cases);
+    return 0;
+}
