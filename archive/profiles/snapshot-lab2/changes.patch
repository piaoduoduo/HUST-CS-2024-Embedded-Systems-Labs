+/* Read-only framebuffer checks before the course's fixed-size renderer runs. */
+#include <linux/fb.h>
+#include <sys/ioctl.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <stdio.h>
+
+int main(void)
+{
+    struct fb_fix_screeninfo fix;
+    struct fb_var_screeninfo var;
+    int fd = open("/dev/fb0", O_RDONLY);
+    if(fd < 0) { perror("open /dev/fb0"); return 1; }
+    if(ioctl(fd, FBIOGET_FSCREENINFO, &fix) < 0 ||
+       ioctl(fd, FBIOGET_VSCREENINFO, &var) < 0) {
+        perror("framebuffer ioctl"); close(fd); return 1;
+    }
+    close(fd);
+    printf("{\"width\":%u,\"height\":%u,\"bits_per_pixel\":%u,"
+           "\"line_length\":%u,\"memory_bytes\":%u,\"xoffset\":%u,\"yoffset\":%u,"
+           "\"red\":[%u,%u],\"green\":[%u,%u],\"blue\":[%u,%u]}\n",
+           var.xres,var.yres,var.bits_per_pixel,fix.line_length,fix.smem_len,
+           var.xoffset,var.yoffset,var.red.offset,var.red.length,
+           var.green.offset,var.green.length,var.blue.offset,var.blue.length);
+    if(var.xres != 1024 || var.yres != 600 || var.bits_per_pixel != 32 ||
+       var.red.offset != 16 || var.red.length != 8 ||
+       var.green.offset != 8 || var.green.length != 8 ||
+       var.blue.offset != 0 || var.blue.length != 8 ||
+       fix.line_length < 1024*4 ||
+       (uint64_t)fix.smem_len < (uint64_t)fix.line_length*600) {
+        fprintf(stderr,"Framebuffer mode differs from the course renderer; adjust mode before running lab2.\n");
+        return 2;
+    }
+    puts("PASS: course framebuffer geometry, RGB layout, stride and memory size");
+    return 0;
+}
