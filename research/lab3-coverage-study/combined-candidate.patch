+                }
+                todo&=~fb_opaque_mask(a,end);
+            }
+        }
+        if(run_l>=0)fb_opaque_copy_run(c,y,run_l,run_r,&result);
+        if(full==FB_OPAQUE_WORDS)break;
+    }
+    return result;
+}
