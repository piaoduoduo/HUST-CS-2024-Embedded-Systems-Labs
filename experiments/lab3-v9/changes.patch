+/* Called only after course timers end. Retain all original drawing work. */
+#include <stdio.h>
+#include <time.h>
+#include <stdint.h>
+#undef fb_update
+void fb_update_impl(void);
+void fb_update(void)
+{
+    struct timespec before, after;
+    clock_gettime(CLOCK_MONOTONIC, &before);
+    fb_update_impl();
+    clock_gettime(CLOCK_MONOTONIC, &after);
+    int64_t us = (int64_t)(after.tv_sec-before.tv_sec)*1000000
+               + (after.tv_nsec-before.tv_nsec)/1000;
+    fprintf(stderr, "FLUSH_US=%lld\n", (long long)us);
+}
