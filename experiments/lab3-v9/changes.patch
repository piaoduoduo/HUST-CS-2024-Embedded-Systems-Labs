+	if(ioctl(fd, FBIOGET_FSCREENINFO, &fb_fix) < 0){
+		printf("Unable to FBIOGET_FSCREENINFO %s\n", dev);
+		return;
+	}
+	if(ioctl(fd, FBIOGET_VSCREENINFO, &fb_var) < 0){
+		printf("Unable to FBIOGET_VSCREENINFO %s\n", dev);
+		return;
+	}
