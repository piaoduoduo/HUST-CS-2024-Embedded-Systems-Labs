+const void *fb_font_identity(void);
+#define FB_LAYOUT_SLOTS 8
+#define FB_LAYOUT_GLYPHS 128
+#define FB_LAYOUT_TEXT_BYTES 256
+#define FB_LAYOUT_MAX_BYTES (64U*1024U)
