+static struct area {
+	int x1, x2, y1, y2;
+} update_area = {0,0,0,0};
+
+#define AREA_SET_EMPTY(pa) do {\
+	(pa)->x1 = SCREEN_WIDTH;\
+	(pa)->x2 = 0;\
+	(pa)->y1 = SCREEN_HEIGHT;\
+	(pa)->y2 = 0;\
