+static void * _begin_draw(int x, int y, int w, int h)
+{
+	int x2 = x+w;
+	int y2 = y+h;
+	if(update_area.x1 > x) update_area.x1 = x;
+	if(update_area.y1 > y) update_area.y1 = y;
+	if(update_area.x2 < x2) update_area.x2 = x2;
+	if(update_area.y2 < y2) update_area.y2 = y2;
+	return DRAW_BUF;
+}
