+/* Blend one channel over an opaque framebuffer, with exact 0/255 endpoints. */
+static unsigned blend_channel(unsigned src, unsigned dst, unsigned alpha)
+{
+    unsigned t = src * alpha + dst * (255-alpha) + 128;
+    return (t + (t >> 8)) >> 8; /* Exact rounded /255 for this bounded domain. */
+}
+
+void fb_draw_image(int x, int y, fb_image *image, int color)
+{
+    if(!image || !image->content || image->pixel_w <= 0 || image->pixel_h <= 0) return;
+    int bytes = image->color_type == FB_COLOR_ALPHA_8 ? 1 : 4;
+    if(image->color_type != FB_COLOR_RGB_8880 &&
+       image->color_type != FB_COLOR_RGBA_8888 &&
+       image->color_type != FB_COLOR_ALPHA_8) return;
+    if(image->line_byte <= 0 || (int64_t)image->pixel_w * bytes > image->line_byte) return;
+
+    int64_t left = x, top = y;
+    int64_t right = (int64_t)x + image->pixel_w;
+    int64_t bottom = (int64_t)y + image->pixel_h;
+    if(left < 0) left = 0;
+    if(top < 0) top = 0;
+    if(right > SCREEN_WIDTH) right = SCREEN_WIDTH;
+    if(bottom > SCREEN_HEIGHT) bottom = SCREEN_HEIGHT;
+    if(left >= right || top >= bottom) return;
+    int ix = (int)(left-x), iy = (int)(top-y);
+    int w = (int)(right-left), h = (int)(bottom-top);
+    int *buf = _begin_draw((int)left, (int)top, w, h);
+    const unsigned char *source = (const unsigned char *)image->content
+        + (size_t)iy * image->line_byte + (size_t)ix * bytes;
+    uint32_t foreground = (uint32_t)color;
+
+    for(int row = 0; row < h; ++row) {
+        uint32_t *dst = (uint32_t *)(buf + ((int)top+row)*SCREEN_WIDTH + (int)left);
+        const unsigned char *src = source + (size_t)row * image->line_byte;
+        if(image->color_type == FB_COLOR_RGB_8880) {
+            memcpy(dst, src, (size_t)w * 4);
+            continue;
+        }
+        for(int column = 0; column < w; ++column) {
+            unsigned alpha, b, g, r;
+            if(bytes == 1) {
+                alpha = src[column];
+                b = foreground & 255; g = (foreground >> 8) & 255; r = (foreground >> 16) & 255;
+            } else {
+                const unsigned char *p = src + column*4;
+                b = p[0]; g = p[1]; r = p[2]; alpha = p[3];
+            }
+            if(alpha == 0) continue;
+            if(alpha != 255) {
+                uint32_t old = dst[column];
+                b = blend_channel(b, old & 255, alpha);
+                g = blend_channel(g, (old >> 8) & 255, alpha);
+                r = blend_channel(r, (old >> 16) & 255, alpha);
+            }
+            dst[column] = UINT32_C(0xff000000) | (r << 16) | (g << 8) | b;
+        }
+    }
+}
+
+void fb_draw_border(int x, int y, int w, int h, int color)
+{
+	if(w<=0 || h<=0) return;
+	fb_draw_rect(x, y, w, 1, color);
+	if(h > 1) {
+		fb_draw_rect(x, y+h-1, w, 1, color);
+		fb_draw_rect(x, y+1, 1, h-2, color);
+		if(w > 1) fb_draw_rect(x+w-1, y+1, 1, h-2, color);
+	}
+}
+
+/** draw a text string **/
+void fb_draw_text(int x, int y, char *text, int font_size, int color)
+{
+	fb_image *img;
+	fb_font_info info;
+	int i=0;
+	int len = strlen(text);
+	while(i < len)
+	{
+		img = fb_read_font_image(text+i, font_size, &info);
+		if(img == NULL) break;
+		fb_draw_image(x+info.left, y-info.top, img, color);
+		fb_free_image(img);
+
+		x += info.advance_x;
+		i += info.bytes;
+	}
+	return;
+}
