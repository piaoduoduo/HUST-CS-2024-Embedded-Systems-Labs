+            fb_fast_row(dst,source+(size_t)row*image->line_byte,w,image->color_type,foreground);
+        }
+        return;
+    }
+    #endif
+    for(int row=0;row<h;++row) {
+        uint32_t *dst=(uint32_t *)(buf+((int)top+row)*SCREEN_WIDTH+(int)left);
+        fb_fast_row(dst,source+(size_t)row*image->line_byte,w,image->color_type,foreground);
+    }
+}
