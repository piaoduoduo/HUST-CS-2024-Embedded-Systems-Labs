+void fb_draw_pixel(int x, int y, int color)
+{
+	if(x<0 || y<0 || x>=SCREEN_WIDTH || y>=SCREEN_HEIGHT) return;
+	int *buf = _begin_draw(x,y,1,1);
+/*---------------------------------------------------*/
+	*(buf + y*SCREEN_WIDTH + x) = color;
+/*---------------------------------------------------*/
+	return;
+}
