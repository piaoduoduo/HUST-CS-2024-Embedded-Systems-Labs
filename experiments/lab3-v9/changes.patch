+	if(pa->x1 < 0) pa->x1 = 0;
+	if(pa->x2 > SCREEN_WIDTH) pa->x2 = SCREEN_WIDTH;
+	if(pa->y1 < 0) pa->y1 = 0;
+	if(pa->y2 > SCREEN_HEIGHT) pa->y2 = SCREEN_HEIGHT;
