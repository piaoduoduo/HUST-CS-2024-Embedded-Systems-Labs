+            unsigned char rgb[3] = {
+                (unsigned char)(color >> 16),
+                (unsigned char)(color >> 8),
+                (unsigned char)color
+            };
+            require(fwrite(rgb, 1, 3, file) == 3, "write preview pixels");
+        }
+    }
+    require(fclose(file) == 0, "close preview file");
