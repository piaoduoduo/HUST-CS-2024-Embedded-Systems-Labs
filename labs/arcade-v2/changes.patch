+#ifndef TOUCH_PROTOCOL_H
+#define TOUCH_PROTOCOL_H
+#include "common.h"
+
+/* Protocol B state, independent of Linux read/ioctl for offline replay. */
+typedef struct { int type, x, y, finger; } touch_sample;
+typedef struct {
+    int x, y, tracking, old_tracking, old_x, old_y, changed;
+} touch_slot;
+typedef struct {
+    touch_slot slots[FINGER_NUM_MAX];
+    touch_sample ready[FINGER_NUM_MAX * 2];
+    int slot, count, next;
+} touch_state;
+void touch_state_init(touch_state *s);
+void touch_state_slot(touch_state *s, int slot);
+void touch_state_tracking(touch_state *s, int tracking);
+void touch_state_position(touch_state *s, int is_y, int value);
+void touch_state_sync(touch_state *s);
+int touch_state_pop(touch_state *s, touch_sample *out);
+int touch_scale_axis(int value, int minimum, int maximum, int pixels);
+#endif
