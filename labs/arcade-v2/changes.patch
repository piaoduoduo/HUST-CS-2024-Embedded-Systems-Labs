+#!/usr/bin/env bash
+set -euo pipefail
+root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+if [ "$#" -ne 1 ]; then echo 'Usage: bash build-on-board.sh /path/to/course-project' >&2; exit 2; fi
+course=$(realpath -- "$1")
+test -f "$course/out/font.ttc"
+test -d "$course/common/external"
+test -f "$course/common/task.c"
+mkdir -p "$root/out" "$root/logs"
+# This isolated release reuses the course event loop; prepared overlays did not ship it.
+if [ ! -f "$root/common/task.c" ]; then cp -- "$course/common/task.c" "$root/common/task.c"; fi
+# All products remain inside this new release. Never overwrite course binaries.
+if [ ! -e "$root/common/external" ]; then ln -s "$course/common/external" "$root/common/external"; fi
+if [ ! -e "$root/out/font.ttc" ]; then ln -s "$course/out/font.ttc" "$root/out/font.ttc"; fi
+exec > >(tee "$root/logs/build.log") 2>&1
+date -Is
+make -B -C "$root/arcade" CC=gcc CFLAGS='-O2 -Wall -Wextra -Wno-unused-parameter'
+make -B -C "$root/lab6_gomoku" CC=gcc CFLAGS='-O2 -Wall -Wextra -Wno-unused-parameter'
+gcc -std=c11 -O2 -Wall -Wextra -Werror "$root/tests/test_arcade.c" "$root/arcade/engine.c" "$root/arcade/breaker.c" "$root/arcade/app.c" -lm -o "$root/out/test_arcade"
+"$root/out/test_arcade"
+gcc -std=c11 -O2 -Wall -Wextra -Werror "$root/tests/test_v2.c" "$root/arcade/engine.c" "$root/arcade/breaker.c" "$root/arcade/app.c" -lm -o "$root/out/test_v2"
+"$root/out/test_v2"
+gcc -std=gnu11 -O2 -Wall -Wextra -Werror "$root/tests/test_profile.c" "$root/arcade/profile.c" -lm -o "$root/out/test_profile"
+mkdir -p "$root/test-results"
+(cd "$root" && ./out/test_profile)
+echo 'Build complete. Run: bash run-on-board.sh [--touch /dev/input/eventN]'
