+    }
+    if(a->mode==1&&a->start_x>=110&&a->start_x<590&&a->start_y>=90&&a->start_y<570) {
+        if(abs(dx)>=35||abs(dy)>=35) {
+            puzzle before=a->puzzle;
+            if(puzzle_move(&a->puzzle,abs(dx)>abs(dy)?(dx<0?0:1):(dy<0?2:3))) {
