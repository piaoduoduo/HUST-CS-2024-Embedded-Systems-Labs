+#!/usr/bin/env bash
+set -euo pipefail
+root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+cd "$root/out"
+mkdir -p "$root/logs"
+exec 9>"$root/out/arcade.lock"
+flock -n 9 || { echo 'Arcade is already running'; exit 1; }
+export LD_LIBRARY_PATH="$root/common/external/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+record=$(mktemp "$root/logs/session-XXXXXX.log")
+exec > >(tee "$record") 2>&1
+# Temporarily stop only the board display manager, restoring it on exit.
+restore=0
+if systemctl is-active --quiet display-manager; then
+    systemctl stop display-manager
+    restore=1
+fi
+cleanup() { if [ "$restore" = 1 ]; then systemctl start display-manager; fi; }
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+while true; do
+    set +e
+    ./lab6_arcade "$@"
+    status=$?
+    set -e
+    if [ "$status" != 42 ]; then exit "$status"; fi
+    # Independent save file preserves the previously accepted gomoku save.
+    set +e
+    ./lab6_gomoku "$@" --save "$root/out/arcade-gomoku-save.txt"
+    status=$?
+    set -e
+    if [ "$status" != 0 ]; then echo "Gomoku exited with error $status; see log"; exit "$status"; fi
+done
