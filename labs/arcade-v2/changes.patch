+                sum+=(v==2?0.9:0.1)*future;
+            }
+        }
+        double value=(empty?sum/empty:evaluate(&moved))+0.1*(moved.score-p->score);
+        if(value>best_value){best_value=value;best=d;}
+    }
+    return best;
+}
