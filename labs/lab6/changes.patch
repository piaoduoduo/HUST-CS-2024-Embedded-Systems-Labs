+#include "touch_protocol.h"
+
+void touch_state_init(touch_state *s)
+{
+    memset(s, 0, sizeof(*s));
+    for(int i = 0; i < FINGER_NUM_MAX; ++i)
+        s->slots[i].tracking = s->slots[i].old_tracking = -1;
+}
+
+void touch_state_slot(touch_state *s, int slot)
+{
+    /* Ignore every update for an unsupported slot, rather than corrupt slot 0. */
+    s->slot = slot >= 0 && slot < FINGER_NUM_MAX ? slot : -1;
+}
+
+void touch_state_tracking(touch_state *s, int tracking)
+{
+    if(s->slot < 0) return;
+    touch_slot *p = &s->slots[s->slot];
+    p->tracking = tracking >= 0 ? tracking : -1;
+    p->changed = 1;
+}
+
+void touch_state_position(touch_state *s, int is_y, int value)
+{
+    if(s->slot < 0) return;
+    touch_slot *p = &s->slots[s->slot];
+    if(is_y) p->y = value; else p->x = value;
+    p->changed = 1;
+}
+
+static void append(touch_state *s, int type, int x, int y, int finger)
+{
+    s->ready[s->count++] = (touch_sample){type, x, y, finger};
+}
+
+void touch_state_sync(touch_state *s)
+{
+    /* Caller drains ready samples before feeding another complete frame. */
+    s->count = s->next = 0;
+    for(int i = 0; i < FINGER_NUM_MAX; ++i) {
+        touch_slot *p = &s->slots[i];
+        if(p->old_tracking >= 0 && p->tracking != p->old_tracking)
+            append(s, TOUCH_RELEASE, p->old_x, p->old_y, i);
+        if(p->tracking >= 0) {
+            if(p->tracking != p->old_tracking)
+                append(s, TOUCH_PRESS, p->x, p->y, i);
+            else if(p->changed && (p->x != p->old_x || p->y != p->old_y))
+                append(s, TOUCH_MOVE, p->x, p->y, i);
+        }
+        p->old_tracking = p->tracking;
+        p->old_x = p->x;
+        p->old_y = p->y;
+        p->changed = 0;
+    }
+}
+
+int touch_state_pop(touch_state *s, touch_sample *out)
+{
+    if(s->next == s->count) return 0;
+    *out = s->ready[s->next++];
+    return 1;
+}
+
+int touch_scale_axis(int value, int minimum, int maximum, int pixels)
+{
+    if(pixels <= 1 || maximum <= minimum || value <= minimum) return 0;
+    if(value >= maximum) return pixels - 1;
+    return (int)(((int64_t)value - minimum) * (pixels - 1) /
+                 ((int64_t)maximum - minimum));
+}
