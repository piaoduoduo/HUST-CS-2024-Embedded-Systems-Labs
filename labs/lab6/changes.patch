+    /* Use the longer axis, ordered consistently for reversed endpoints. */
+    int64_t major1 = steep ? y1 : x1;
+    int64_t major2 = steep ? y2 : x2;
+    int64_t minor1 = steep ? x1 : y1;
+    int64_t minor2 = steep ? x2 : y2;
+    if(major1 > major2) {
