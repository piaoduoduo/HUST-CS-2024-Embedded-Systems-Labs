+    struct input_absinfo *axis=data;memset(axis,0,sizeof(*axis));
+    if(request==EVIOCGABS(ABS_MT_SLOT)) { axis->value=current_slot;axis->maximum=5; }
+    else if(request==EVIOCGABS(ABS_MT_POSITION_X) || request==EVIOCGABS(ABS_MT_POSITION_Y)) axis->maximum=4096;
+    else { errno=EINVAL;return -1; }
+    return 0;
+}
+static ssize_t fake_read(int fd,void *data,size_t size)
+{
+    assert(fd==7 && size==sizeof(struct input_event));
+    if(event_next==event_count) { errno=EAGAIN;return -1; }
+    memcpy(data,&events[event_next++],size);return (ssize_t)size;
+}
+#define open fake_open
+#define close fake_close
+#define ioctl fake_ioctl
+#define read fake_read
+#include "../common/touch.c"
+#undef open
+#undef close
+#undef ioctl
+#undef read
+static void event(int type,int code,int value)
+{
+    assert(event_count<16);struct input_event *e=&events[event_count++];
+    memset(e,0,sizeof(*e));e->type=type;e->code=code;e->value=value;
+}
+int main(void)
+{
+    int x,y,finger;assert(touch_init("mock") == 7);
+    /* Kernel slot 2 and both coordinates are unchanged: only new ID is sent. */
+    event(EV_ABS,ABS_MT_TRACKING_ID,88);event(EV_SYN,SYN_REPORT,0);
+    assert(touch_read(7,&x,&y,&finger)==TOUCH_PRESS && finger==2);
+    assert(x==1200*1023/4096 && y==2200*599/4096);
+    event(EV_ABS,ABS_MT_TRACKING_ID,-1);event(EV_SYN,SYN_REPORT,0);
+    assert(touch_read(7,&x,&y,&finger)==TOUCH_RELEASE && finger==2);
+    assert(touch_read(7,&x,&y,&finger)==TOUCH_NO_EVENT);
+    held_slot=1;assert(touch_init("mock")==-1 && errno==EBUSY && closed==1);
+    held_slot=-1;query_error=1;assert(touch_init("mock")==-1 && errno==EIO && closed==2);
+    query_error=0;current_slot=5;assert(touch_init("mock")==7);
+    event_count=event_next=0;
+    event(EV_ABS,ABS_MT_TRACKING_ID,99);event(EV_SYN,SYN_REPORT,0);
+    assert(touch_read(7,&x,&y,&finger)==TOUCH_NO_EVENT);
+    event(EV_ABS,ABS_MT_SLOT,1);event(EV_ABS,ABS_MT_TRACKING_ID,100);event(EV_SYN,SYN_REPORT,0);
+    assert(touch_read(7,&x,&y,&finger)==TOUCH_PRESS && finger==1);
+    assert(x==1100*1023/4096 && y==2100*599/4096);
+    puts("PASS: current slot/unchanged coordinates, paired release, held-finger refusal, ioctl failure, unsupported slot recovery (mock syscalls)");
+    return 0;
+}
