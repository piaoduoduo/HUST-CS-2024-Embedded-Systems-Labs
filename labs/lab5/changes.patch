+        major1 = major2;
+        major2 = temporary;
+        temporary = minor1;
+        minor1 = minor2;
+        minor2 = temporary;
+    }
+
+    uint64_t length = (uint64_t)(major2 - major1);
+    if(length == 0) {
+        fb_draw_pixel(x1, y1, color);
+        return;
+    }
