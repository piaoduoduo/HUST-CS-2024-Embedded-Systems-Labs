+#include "serial_session.h"
+#include <string.h>
+
+void bt_session_init(bt_session *s, const bt_transport *io,
+                     bt_line_fn emit, void *context, uint32_t now)
+{
+    memset(s, 0, sizeof(*s)); s->io = *io; s->fd = -1;
+    s->retry_at = s->last_receive = now;
+    bt_text_init(&s->receiver, emit, context);
+}
+
+void bt_session_close(bt_session *s, uint32_t now)
+{
+    if(s->fd < 0) return;
+    int old = s->fd;
+    size_t discarded = s->outgoing.length - s->outgoing.offset;
+    s->fd = -1;
+    /* A peer may have received the prefix: never replay a tail to a new link. */
+    memset(&s->outgoing, 0, sizeof(s->outgoing));
+    bt_text_flush(&s->receiver, 1);
+    if(s->io.state) s->io.state(old, 0, discarded, s->io.context);
+    s->io.close(old, s->io.context);
+    s->retry_at = now + 1000u;
+}
+
+static int writer(const char *data, size_t length, void *context)
+{
+    bt_session *s = context;
+    return s->io.write(s->fd, data, length, s->io.context);
+}
+
+static int flush_tx(bt_session *s, uint32_t now)
+{
+    if(bt_tx_flush(&s->outgoing, writer, s) >= 0) return 0;
+    bt_session_close(s, now);
+    return -1;
+}
+
+int bt_session_send(bt_session *s, const char *data, size_t length, uint32_t now)
+{
+    if(s->fd < 0 || bt_tx_enqueue(&s->outgoing, data, length) < 0) return -1;
+    return flush_tx(s, now);
+}
+
+void bt_session_tick(bt_session *s, uint32_t now)
+{
+    if(s->fd < 0) {
+        /* Unsigned wrap-safe deadline, valid for intervals below 2^31 ms. */
+        if((uint32_t)(now - s->retry_at) >= UINT32_C(0x80000000)) return;
+        s->retry_at = now + 1000u;
+        int fd = s->io.open(s->io.context);
+        if(fd < 0) return;
+        s->fd = fd; s->last_receive = now;
+        if(s->io.state) s->io.state(fd, 1, 0, s->io.context);
+    }
+    if(flush_tx(s, now) < 0) return;
+    if((uint32_t)(now - s->last_receive) >= 500u)
+        bt_text_flush(&s->receiver, 0);
+}
+
+void bt_session_readable(bt_session *s, uint32_t now)
+{
+    if(s->fd < 0) return;
+    /* A busy peer cannot monopolize the task loop. Remaining bytes stay ready. */
+    for(unsigned budget = 0; budget < 16; ++budget) {
+        uint8_t data[256];
+        int n = s->io.read(s->fd, data, sizeof(data), s->io.context);
+        if(n > 0 && (size_t)n <= sizeof(data)) {
+            s->last_receive = now;
+            bt_text_feed(&s->receiver, data, (size_t)n);
+        } else if(n == BT_IO_RETRY) continue;
+        else if(n == BT_IO_WAIT) return;
+        else { bt_session_close(s, now); return; }
+    }
+}
