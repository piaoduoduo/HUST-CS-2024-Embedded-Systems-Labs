+#define BT_IO_WAIT (-2)
+#define BT_IO_ERROR (-3)
+typedef struct { char bytes[256]; size_t length, offset; } bt_tx_queue;
+typedef int (*bt_writer_fn)(const char *data, size_t length, void *context);
+int bt_tx_enqueue(bt_tx_queue *q, const char *data, size_t length);
+int bt_tx_flush(bt_tx_queue *q, bt_writer_fn writer, void *context);
