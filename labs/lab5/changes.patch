+void bt_text_init(bt_text_stream *s, bt_line_fn emit, void *context)
+{
+    memset(s, 0, sizeof(*s));
+    s->emit = emit;
+    s->context = context;
+}
+
+static void emit_line(bt_text_stream *s)
+{
+    if(!s->used) return;
+    s->line[s->used] = '\0';
+    if(s->emit) s->emit(s->line, s->context);
+    s->used = 0;
+}
+
+static void append(bt_text_stream *s, const uint8_t *bytes, size_t length)
+{
+    /* Never split a UTF-8 codepoint at the bounded line-buffer boundary. */
+    if(s->used + length >= sizeof(s->line)) emit_line(s);
+    memcpy(s->line + s->used, bytes, length);
+    s->used += length;
+}
+
+void bt_text_feed(bt_text_stream *s, const uint8_t *data, size_t length)
+{
+    for(size_t i = 0; i < length; ++i) {
+        uint8_t c = data[i];
+        if(s->have) {
+            int valid = c >= 0x80 && c <= 0xbf;
+            if(s->have == 1) {
+                if(s->sequence[0] == 0xe0 && c < 0xa0) valid = 0;
+                if(s->sequence[0] == 0xed && c >= 0xa0) valid = 0;
+                if(s->sequence[0] == 0xf0 && c < 0x90) valid = 0;
+                if(s->sequence[0] == 0xf4 && c >= 0x90) valid = 0;
+            }
+            if(valid) {
+                s->sequence[s->have++] = c;
+                if(s->have == s->need) {
+                    append(s, s->sequence, s->need);
+                    s->have = s->need = 0;
+                }
+                continue;
+            }
+            append(s, (const uint8_t *)"?", 1);
+            s->have = s->need = 0;
+            /* Reprocess this byte as the start of a new character. */
+        }
+        if(c == '\n') { emit_line(s); continue; }
+        if(c == '\r') continue;
+        if(c < 0x20 || c == 0x7f) { append(s, (const uint8_t *)"?", 1); continue; }
+        if(c < 0x80) { append(s, &c, 1); continue; }
+        s->need = c >= 0xc2 && c <= 0xdf ? 2 :
+                  c >= 0xe0 && c <= 0xef ? 3 :
+                  c >= 0xf0 && c <= 0xf4 ? 4 : 0;
+        if(s->need) { s->sequence[0] = c; s->have = 1; }
+        else append(s, (const uint8_t *)"?", 1);
+    }
+}
+
+void bt_text_flush(bt_text_stream *s, int end_of_stream)
+{
+    if(end_of_stream && s->have) {
+        append(s, (const uint8_t *)"?", 1);
+        s->have = s->need = 0;
+    }
+    emit_line(s);
+}
