+static int open_io(void *context)
+{ fake *f=context; ++f->opens; return f->available ? ++f->active : -1; }
+static int read_io(int fd,uint8_t *p,size_t n,void *context)
+{
+    fake *f=context; CHECK(fd==f->active); ++f->read_calls;
+    if(f->read_mode==1) return BT_IO_RETRY;
+    if(f->read_mode==2) return 0;
+    if(f->read_mode==3) return BT_IO_ERROR;
+    if(f->pos==f->used) return BT_IO_WAIT;
+    if(n>f->used-f->pos) n=f->used-f->pos;
+    memcpy(p,f->input+f->pos,n); f->pos+=n; return (int)n;
+}
+static int write_io(int fd,const char *p,size_t n,void *context)
+{
+    fake *f=context; CHECK(fd==f->active); ++f->write_calls;
+    if(f->write_mode==1) return BT_IO_RETRY;
+    if(f->write_mode==2) return BT_IO_WAIT;
+    if(f->write_mode==3) return BT_IO_ERROR;
+    if(f->write_mode==4) { if(n>2)n=2; f->write_mode=2; }
+    CHECK(f->sent+n<=sizeof(f->output)); memcpy(f->output+f->sent,p,n); f->sent+=n;
+    return (int)n;
