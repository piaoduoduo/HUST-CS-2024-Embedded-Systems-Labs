+#include "../common/common.h"
+#include "drawing.h"
+
+#define TOOLBAR_H 64
+#define CLEAR_X (SCREEN_WIDTH - 140)
+#define RADIUS 4
+#define BACKGROUND FB_COLOR(255,255,255)
+static const int colors[FINGER_NUM_MAX] = {
+    FB_COLOR(230,40,40), FB_COLOR(20,110,230), FB_COLOR(20,155,65),
+    FB_COLOR(170,60,200), FB_COLOR(245,145,10)
+};
+static struct { int down, active, suppressed, x, y; } pens[FINGER_NUM_MAX];
+
+static void clear_canvas(void)
+{
+    fb_draw_rect(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, BACKGROUND);
+    fb_draw_rect(0, 0, SCREEN_WIDTH, TOOLBAR_H, FB_COLOR(235,240,245));
+    fb_draw_text(16, 40, "五指画板", 28, FB_COLOR(25,35,50));
+    for(int i = 0; i < FINGER_NUM_MAX; ++i)
+        fb_draw_rect(220 + i * 40, 22, 24, 24, colors[i]);
+    fb_draw_rect(CLEAR_X, 0, 140, TOOLBAR_H, FB_COLOR(215,225,235));
+    fb_draw_border(CLEAR_X, 0, 140, TOOLBAR_H, FB_COLOR(60,70,80));
+    fb_draw_text(CLEAR_X + 22, 41, "清屏", 28, FB_COLOR(25,35,50));
+}
+
+static void stamp(int x, int y, int color)
+{
+    for(int dy = -RADIUS; dy <= RADIUS; ++dy)
+        for(int dx = -RADIUS; dx <= RADIUS; ++dx)
+            if(dx*dx + dy*dy <= RADIUS*RADIUS && y+dy >= TOOLBAR_H)
+                fb_draw_pixel(x+dx, y+dy, color);
+}
+
+static void stroke(int x0, int y0, int x1, int y1, int color)
+{
+    /* Stamp along every Bresenham point; fast motion remains connected. */
+    int dx = abs(x1-x0), sx = x0 < x1 ? 1 : -1;
+    int dy = -abs(y1-y0), sy = y0 < y1 ? 1 : -1;
+    int error = dx+dy;
+    for(;;) {
+        stamp(x0, y0, color);
+        if(x0 == x1 && y0 == y1) break;
+        int twice = 2*error;
+        if(twice >= dy) { error += dy; x0 += sx; }
+        if(twice <= dx) { error += dx; y0 += sy; }
+    }
+}
+
+void lab4_canvas_init(void)
+{
+    memset(pens, 0, sizeof(pens));
+    clear_canvas();
+}
+
+void lab4_canvas_event(int type, int x, int y, int finger)
+{
+    if(finger < 0 || finger >= FINGER_NUM_MAX ||
+       x < 0 || x >= SCREEN_WIDTH || y < 0 || y >= SCREEN_HEIGHT) return;
+    if(type == TOUCH_PRESS) {
+        pens[finger].down = 1;
+        pens[finger].active = pens[finger].suppressed = 0;
+        if(x >= CLEAR_X && y < TOOLBAR_H) {
+            for(int i = 0; i < FINGER_NUM_MAX; ++i) {
+                pens[i].suppressed = pens[i].down;
+                pens[i].active = 0;
+            }
+            clear_canvas();
+            return;
+        }
+    }
+    if((type == TOUCH_PRESS || type == TOUCH_MOVE || type == TOUCH_RELEASE) &&
+       pens[finger].down && !pens[finger].suppressed) {
+        if(y >= TOOLBAR_H) {
+            if(pens[finger].active)
+                stroke(pens[finger].x, pens[finger].y, x, y, colors[finger]);
+            else stamp(x, y, colors[finger]);
+            pens[finger].x = x; pens[finger].y = y;
+            pens[finger].active = 1;
+        } else pens[finger].active = 0;
+    }
+    if(type == TOUCH_RELEASE) {
+        pens[finger].down = pens[finger].active = pens[finger].suppressed = 0;
+    }
+}
